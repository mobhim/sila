# Copy this file to .env and put a key in it. Never commit .env. Without any key the site runs on its written rules.
# A free key (Groq: gsk_..., or Google AI Studio: AIza...) is enough for the agent's optional model brain:
SILA_LLM_KEY=
# Or a Claude key; when both are set, Claude is used:
ANTHROPIC_API_KEY=

# Optional
# SILA_LLM_MODEL=            (picked from the provider's list when empty)
# SILA_LLM_URL=              (any OpenAI-compatible endpoint)
# SILA_MODEL=claude-opus-5-5
# SILA_RATE_PER_MIN=30
# SILA_DAILY_CAP=3000
# SILA_ALLOWED_ORIGINS=https://your-name.github.io
# PORT=3000
