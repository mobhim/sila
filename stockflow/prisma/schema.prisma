generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
  SUPPLIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum Unit {
  PIECE
  BOX
  CARTON
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  BOTTLE
  PACK
  METER
}

enum TxType {
  INITIAL_STOCK
  CONSUMPTION
  WITHDRAWAL
  STOCK_RECEIPT
  PURCHASE_RECEIPT
  RETURN
  DAMAGED
  EXPIRED
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  COUNT_CORRECTION
}

enum AlertLevel {
  LOW
  CRITICAL
  OUT_OF_STOCK
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  REPLENISHMENT_PENDING
  RESOLVED
}

enum ReplenishmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_SUPPLIER
  ACCEPTED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RequestSource {
  AUTO
  MANUAL
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum CountStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AdjustmentKind {
  DAMAGED
  EXPIRED
  MISSING
  CORRECTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Channel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
  SKIPPED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  phone              String?
  passwordHash       String     @map("password_hash")
  role               Role
  status             UserStatus @default(ACTIVE)
  locale             String     @default("ar")
  supplierId         String?    @map("supplier_id")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  notifyEmail        Boolean    @default(true) @map("notify_email")
  notifyWhatsapp     Boolean    @default(false) @map("notify_whatsapp")
  notifySms          Boolean    @default(false) @map("notify_sms")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  supplier         Supplier?                @relation(fields: [supplierId], references: [id])
  sessions         Session[]
  branches         BranchUser[]
  managedBranches  Branch[]                 @relation("BranchManager")
  transactions     InventoryTransaction[]
  notifications    Notification[]
  favorites        UserFavoriteProduct[]
  auditLogs        AuditLog[]
  adjustmentsAsked StockAdjustmentRequest[] @relation("AdjustmentRequester")
  adjustmentsDone  StockAdjustmentRequest[] @relation("AdjustmentReviewer")

  @@index([role])
  @@index([supplierId])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@map("rate_limits")
}

// ───────────────────────────── Branches ─────────────────────────────

model Branch {
  id                     String       @id @default(cuid())
  code                   String       @unique
  name                   String
  nameAr                 String?      @map("name_ar")
  address                String?
  city                   String?
  phone                  String?
  email                  String?
  managerId              String?      @map("manager_id")
  status                 BranchStatus @default(ACTIVE)
  autoDraftReplenishment Boolean      @default(true) @map("auto_draft_replenishment")
  reviewPeriodDays       Int          @default(7) @map("review_period_days")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  manager            User?                    @relation("BranchManager", fields: [managerId], references: [id])
  users              BranchUser[]
  inventory          BranchInventory[]
  transactions       InventoryTransaction[]
  alerts             StockAlert[]
  replenishments     ReplenishmentRequest[]
  transfersOut       InventoryTransfer[]      @relation("TransferSource")
  transfersIn        InventoryTransfer[]      @relation("TransferDestination")
  counts             InventoryCount[]
  adjustmentRequests StockAdjustmentRequest[]

  @@map("branches")
}

model BranchUser {
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("branch_users")
}

// ───────────────────────────── Catalog ─────────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String?  @map("name_ar")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  counts   InventoryCount[]

  @@map("product_categories")
}

model Supplier {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  contactName  String?      @map("contact_name")
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  vatNumber    String?      @map("vat_number")
  leadTimeDays Int          @default(3) @map("lead_time_days")
  status       RecordStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users          User[]
  products       Product[]
  replenishments ReplenishmentRequest[]

  @@map("suppliers")
}

model Product {
  id                String       @id @default(cuid())
  sku               String       @unique
  barcode           String?      @unique
  name              String
  nameAr            String?      @map("name_ar")
  description       String?
  categoryId        String?      @map("category_id")
  baseUnit          Unit         @default(PIECE) @map("base_unit")
  imageId           String?      @map("image_id")
  defaultSupplierId String?      @map("default_supplier_id")
  costPrice         Decimal      @default(0) @map("cost_price") @db.Decimal(14, 2)
  sellingPrice      Decimal?     @map("selling_price") @db.Decimal(14, 2)
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  category      ProductCategory?           @relation(fields: [categoryId], references: [id])
  supplier      Supplier?                  @relation(fields: [defaultSupplierId], references: [id])
  image         Attachment?                @relation("ProductImage", fields: [imageId], references: [id])
  units         ProductUnit[]
  inventory     BranchInventory[]
  transactions  InventoryTransaction[]
  alerts        StockAlert[]
  favorites     UserFavoriteProduct[]
  replenItems   ReplenishmentRequestItem[]
  transferItems InventoryTransferItem[]
  countItems    InventoryCountItem[]
  adjustments   StockAdjustmentRequest[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

/// A unit the product can be handled in, with how many base units it contains.
model ProductUnit {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  unit        Unit
  factor      Decimal @db.Decimal(14, 4)
  barcode     String? @unique
  /// Unit suppliers deliver in; replenishment quantities are rounded up to it.
  isOrderUnit Boolean @default(false) @map("is_order_unit")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unit])
  @@map("product_units")
}

model UserFavoriteProduct {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("user_favorite_products")
}

// ───────────────────────────── Inventory ─────────────────────────────

model BranchInventory {
  id                  String    @id @default(cuid())
  branchId            String    @map("branch_id")
  productId           String    @map("product_id")
  quantity            Decimal   @default(0) @db.Decimal(18, 3)
  reserved            Decimal   @default(0) @db.Decimal(18, 3)
  minStock            Decimal   @default(0) @map("min_stock") @db.Decimal(18, 3)
  criticalStock       Decimal?  @map("critical_stock") @db.Decimal(18, 3)
  reorderQty          Decimal   @default(0) @map("reorder_qty") @db.Decimal(18, 3)
  maxStock            Decimal   @default(0) @map("max_stock") @db.Decimal(18, 3)
  safetyStock         Decimal   @default(0) @map("safety_stock") @db.Decimal(18, 3)
  avgDailyConsumption Decimal   @default(0) @map("avg_daily_consumption") @db.Decimal(18, 3)
  lastMovementAt      DateTime? @map("last_movement_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  branch       Branch                 @relation(fields: [branchId], references: [id])
  product      Product                @relation(fields: [productId], references: [id])
  transactions InventoryTransaction[]

  @@unique([branchId, productId])
  @@index([productId])
  @@map("branch_inventory")
}

/// Append-only ledger. A database trigger rejects UPDATE and DELETE.
model InventoryTransaction {
  id              String   @id @default(cuid())
  seq             Int      @unique @default(autoincrement())
  branchId        String   @map("branch_id")
  productId       String   @map("product_id")
  inventoryId     String   @map("inventory_id")
  type            TxType
  /// Signed change in base units (negative = stock leaving).
  quantity        Decimal  @db.Decimal(18, 3)
  enteredQuantity Decimal  @map("entered_quantity") @db.Decimal(18, 3)
  enteredUnit     Unit     @map("entered_unit")
  unitFactor      Decimal  @default(1) @map("unit_factor") @db.Decimal(14, 4)
  previousQty     Decimal  @map("previous_qty") @db.Decimal(18, 3)
  newQty          Decimal  @map("new_qty") @db.Decimal(18, 3)
  unitCost        Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 2)
  userId          String   @map("user_id")
  reason          String?
  notes           String?
  idempotencyKey  String?  @unique @map("idempotency_key")
  replenishmentId String?  @map("replenishment_id")
  receiptId       String?  @map("receipt_id")
  transferId      String?  @map("transfer_id")
  countId         String?  @map("count_id")
  adjustmentId    String?  @unique @map("adjustment_id")
  attachmentId    String?  @map("attachment_id")
  createdAt       DateTime @default(now()) @map("created_at")

  branch        Branch                  @relation(fields: [branchId], references: [id])
  product       Product                 @relation(fields: [productId], references: [id])
  inventory     BranchInventory         @relation(fields: [inventoryId], references: [id])
  user          User                    @relation(fields: [userId], references: [id])
  replenishment ReplenishmentRequest?   @relation(fields: [replenishmentId], references: [id])
  receipt       ReplenishmentReceipt?   @relation(fields: [receiptId], references: [id])
  transfer      InventoryTransfer?      @relation(fields: [transferId], references: [id])
  count         InventoryCount?         @relation(fields: [countId], references: [id])
  adjustment    StockAdjustmentRequest? @relation(fields: [adjustmentId], references: [id])
  attachment    Attachment?             @relation(fields: [attachmentId], references: [id])

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([inventoryId, createdAt])
  @@map("inventory_transactions")
}

model StockAlert {
  id                String      @id @default(cuid())
  branchId          String      @map("branch_id")
  productId         String      @map("product_id")
  level             AlertLevel
  status            AlertStatus @default(OPEN)
  quantityAtTrigger Decimal     @map("quantity_at_trigger") @db.Decimal(18, 3)
  minStockAtTrigger Decimal     @map("min_stock_at_trigger") @db.Decimal(18, 3)
  currentQuantity   Decimal     @map("current_quantity") @db.Decimal(18, 3)
  recommendedQty    Decimal     @default(0) @map("recommended_qty") @db.Decimal(18, 3)
  replenishmentId   String?     @map("replenishment_id")
  acknowledgedById  String?     @map("acknowledged_by_id")
  acknowledgedAt    DateTime?   @map("acknowledged_at")
  triggeredAt       DateTime    @default(now()) @map("triggered_at")
  levelChangedAt    DateTime    @default(now()) @map("level_changed_at")
  resolvedAt        DateTime?   @map("resolved_at")

  branch        Branch                @relation(fields: [branchId], references: [id])
  product       Product               @relation(fields: [productId], references: [id])
  replenishment ReplenishmentRequest? @relation(fields: [replenishmentId], references: [id])

  // Partial unique index "stock_alerts_one_open_per_item" is created in SQL migration.
  @@index([status, level])
  @@index([branchId, productId])
  @@map("stock_alerts")
}

model StockAdjustmentRequest {
  id            String         @id @default(cuid())
  seq           Int            @unique @default(autoincrement())
  branchId      String         @map("branch_id")
  productId     String         @map("product_id")
  kind          AdjustmentKind
  /// Signed change in base units.
  quantity      Decimal        @db.Decimal(18, 3)
  reason        String
  notes         String?
  attachmentId  String?        @map("attachment_id")
  status        ApprovalStatus @default(PENDING)
  requestedById String         @map("requested_by_id")
  reviewedById  String?        @map("reviewed_by_id")
  reviewedAt    DateTime?      @map("reviewed_at")
  reviewNote    String?        @map("review_note")
  createdAt     DateTime       @default(now()) @map("created_at")

  branch      Branch                @relation(fields: [branchId], references: [id])
  product     Product               @relation(fields: [productId], references: [id])
  attachment  Attachment?           @relation(fields: [attachmentId], references: [id])
  requestedBy User                  @relation("AdjustmentRequester", fields: [requestedById], references: [id])
  reviewedBy  User?                 @relation("AdjustmentReviewer", fields: [reviewedById], references: [id])
  transaction InventoryTransaction?

  @@index([branchId, status])
  @@map("stock_adjustment_requests")
}

// ───────────────────────────── Replenishment ─────────────────────────────

model ReplenishmentRequest {
  id            String              @id @default(cuid())
  seq           Int                 @unique @default(autoincrement())
  branchId      String              @map("branch_id")
  supplierId    String?             @map("supplier_id")
  status        ReplenishmentStatus @default(DRAFT)
  source        RequestSource       @default(MANUAL)
  createdById   String?             @map("created_by_id")
  approvedById  String?             @map("approved_by_id")
  approvedAt    DateTime?           @map("approved_at")
  sentAt        DateTime?           @map("sent_at")
  acceptedAt    DateTime?           @map("accepted_at")
  expectedAt    DateTime?           @map("expected_at")
  completedAt   DateTime?           @map("completed_at")
  cancelledAt   DateTime?           @map("cancelled_at")
  cancelReason  String?             @map("cancel_reason")
  notes         String?
  supplierNotes String?             @map("supplier_notes")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  branch       Branch                     @relation(fields: [branchId], references: [id])
  supplier     Supplier?                  @relation(fields: [supplierId], references: [id])
  items        ReplenishmentRequestItem[]
  receipts     ReplenishmentReceipt[]
  documents    ReplenishmentDocument[]
  transactions InventoryTransaction[]
  alerts       StockAlert[]

  @@index([branchId, status])
  @@index([supplierId, status])
  @@map("replenishment_requests")
}

model ReplenishmentRequestItem {
  id                   String   @id @default(cuid())
  requestId            String   @map("request_id")
  productId            String   @map("product_id")
  recommendedQty       Decimal  @default(0) @map("recommended_qty") @db.Decimal(18, 3)
  requestedQty         Decimal  @map("requested_qty") @db.Decimal(18, 3)
  supplierConfirmedQty Decimal? @map("supplier_confirmed_qty") @db.Decimal(18, 3)
  receivedQty          Decimal  @default(0) @map("received_qty") @db.Decimal(18, 3)
  unitCost             Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 2)
  /// How the recommendation was computed (inputs and intermediate values).
  calculation          Json?

  request      ReplenishmentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product      Product                    @relation(fields: [productId], references: [id])
  receiptItems ReplenishmentReceiptItem[]

  @@unique([requestId, productId])
  @@index([productId])
  @@map("replenishment_request_items")
}

model ReplenishmentReceipt {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  receivedById String   @map("received_by_id")
  notes        String?
  attachmentId String?  @map("attachment_id")
  createdAt    DateTime @default(now()) @map("created_at")

  request      ReplenishmentRequest       @relation(fields: [requestId], references: [id])
  attachment   Attachment?                @relation(fields: [attachmentId], references: [id])
  items        ReplenishmentReceiptItem[]
  transactions InventoryTransaction[]

  @@index([requestId])
  @@map("replenishment_receipts")
}

model ReplenishmentReceiptItem {
  id        String  @id @default(cuid())
  receiptId String  @map("receipt_id")
  itemId    String  @map("item_id")
  quantity  Decimal @db.Decimal(18, 3)

  receipt ReplenishmentReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    ReplenishmentRequestItem @relation(fields: [itemId], references: [id])

  @@map("replenishment_receipt_items")
}

// ───────────────────────────── Transfers ─────────────────────────────

model InventoryTransfer {
  id                  String         @id @default(cuid())
  seq                 Int            @unique @default(autoincrement())
  sourceBranchId      String         @map("source_branch_id")
  destinationBranchId String         @map("destination_branch_id")
  status              TransferStatus @default(REQUESTED)
  requestedById       String         @map("requested_by_id")
  approvedById        String?        @map("approved_by_id")
  dispatchedById      String?        @map("dispatched_by_id")
  receivedById        String?        @map("received_by_id")
  approvedAt          DateTime?      @map("approved_at")
  dispatchedAt        DateTime?      @map("dispatched_at")
  completedAt         DateTime?      @map("completed_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  cancelReason        String?        @map("cancel_reason")
  notes               String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  source       Branch                  @relation("TransferSource", fields: [sourceBranchId], references: [id])
  destination  Branch                  @relation("TransferDestination", fields: [destinationBranchId], references: [id])
  items        InventoryTransferItem[]
  transactions InventoryTransaction[]

  @@index([sourceBranchId, status])
  @@index([destinationBranchId, status])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id            String  @id @default(cuid())
  transferId    String  @map("transfer_id")
  productId     String  @map("product_id")
  requestedQty  Decimal @map("requested_qty") @db.Decimal(18, 3)
  dispatchedQty Decimal @default(0) @map("dispatched_qty") @db.Decimal(18, 3)
  receivedQty   Decimal @default(0) @map("received_qty") @db.Decimal(18, 3)

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
  @@map("inventory_transfer_items")
}

// ───────────────────────────── Counts ─────────────────────────────

model InventoryCount {
  id            String      @id @default(cuid())
  seq           Int         @unique @default(autoincrement())
  branchId      String      @map("branch_id")
  categoryId    String?     @map("category_id")
  status        CountStatus @default(IN_PROGRESS)
  createdById   String      @map("created_by_id")
  submittedById String?     @map("submitted_by_id")
  reviewedById  String?     @map("reviewed_by_id")
  submittedAt   DateTime?   @map("submitted_at")
  reviewedAt    DateTime?   @map("reviewed_at")
  reviewNote    String?     @map("review_note")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  branch       Branch                 @relation(fields: [branchId], references: [id])
  category     ProductCategory?       @relation(fields: [categoryId], references: [id])
  items        InventoryCountItem[]
  transactions InventoryTransaction[]

  @@index([branchId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id          String    @id @default(cuid())
  countId     String    @map("count_id")
  productId   String    @map("product_id")
  /// System quantity at the moment the line was counted.
  systemQty   Decimal?  @map("system_qty") @db.Decimal(18, 3)
  countedQty  Decimal?  @map("counted_qty") @db.Decimal(18, 3)
  reason      String?
  countedById String?   @map("counted_by_id")
  countedAt   DateTime? @map("counted_at")

  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
  @@map("inventory_count_items")
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

/// Status history for replenishment requests, transfers, counts and adjustments.
model WorkflowEvent {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  userId     String?  @map("user_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("workflow_events")
}

model Attachment {
  id           String   @id @default(cuid())
  storageKey   String   @unique @map("storage_key")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  size         Int
  uploadedById String   @map("uploaded_by_id")
  /// Branch the file belongs to (for access checks); null = organization-wide.
  branchId     String?  @map("branch_id")
  /// Supplier that may read the file (delivery documents).
  supplierId   String?  @map("supplier_id")
  createdAt    DateTime @default(now()) @map("created_at")

  products     Product[]                @relation("ProductImage")
  transactions InventoryTransaction[]
  adjustments  StockAdjustmentRequest[]
  receipts     ReplenishmentReceipt[]
  documents    ReplenishmentDocument[]

  @@map("attachments")
}

/// Documents attached to a replenishment request (supplier delivery notes, invoices).
model ReplenishmentDocument {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  attachmentId String   @map("attachment_id")
  uploadedById String   @map("uploaded_by_id")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")

  attachment Attachment           @relation(fields: [attachmentId], references: [id])
  request    ReplenishmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("replenishment_documents")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  severity  String    @default("info")
  title     String
  body      String
  link      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String         @id @default(cuid())
  notificationId    String         @map("notification_id")
  channel           Channel
  destination       String
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at")
  lastError         String?        @map("last_error")
  providerMessageId String?        @map("provider_message_id")
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  branchId   String?  @map("branch_id")
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  key       String   @id
  userId    String   @map("user_id")
  scope     String
  result    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

/// Organization settings — always exactly one row with id = 1.
model Settings {
  id                       Int      @id @default(1)
  businessName             String   @default("STOCKFLOW") @map("business_name")
  vatNumber                String?  @map("vat_number")
  currency                 String   @default("SAR")
  allowNegativeStock       Boolean  @default(false) @map("allow_negative_stock")
  criticalPercent          Int      @default(50) @map("critical_percent")
  consumptionWindowDays    Int      @default(30) @map("consumption_window_days")
  safetyDays               Int      @default(2) @map("safety_days")
  autoDraftReplenishment   Boolean  @default(true) @map("auto_draft_replenishment")
  /// Separate automated purchasing policy: auto-approve and send drafts. Off by default.
  autoApproveReplenishment Boolean  @default(false) @map("auto_approve_replenishment")
  showHijri                Boolean  @default(true) @map("show_hijri")
  emailEnabled             Boolean  @default(true) @map("email_enabled")
  whatsappEnabled          Boolean  @default(false) @map("whatsapp_enabled")
  smsEnabled               Boolean  @default(false) @map("sms_enabled")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
